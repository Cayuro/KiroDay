{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Terminal de bienvenida",
      "type": "shell",
      "command": "bash",
      "args": ["--rcfile", "/root/.bashrc", "-i"],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "showReuseMessage": false,
        "clear": true,
        "close": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "."
        }
      }
    }
  ]
}
